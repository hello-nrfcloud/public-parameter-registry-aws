{
  "name": "@bifravst/public-parameter-registry",
  "version": "0.0.0-development",
  "description": "Public parameter registry developed using AWS CDK in TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --no-warnings --test ./lambda/*.spec.ts",
    "test:e2e": "$(set -o pipefail && node --experimental-transform-types ./feature-runner/run-features.ts | node --experimental-transform-types ./feature-runner/console-reporter.ts)",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/public-parameter-registry-aws.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/public-parameter-registry-aws/issues"
  },
  "homepage": "https://github.com/hello-nrfcloud/public-parameter-registry-aws#readme",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "aws",
    "cdk"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "3.1116.0",
    "@aws-sdk/client-iam": "3.1116.0",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/client-ssm": "3.1116.0",
    "@bifravst/aws-cdk-lambda-helpers": "5.0.5",
    "@bifravst/bdd-markdown": "9.0.2",
    "@bifravst/ci": "3.0.1",
    "@bifravst/cloudformation-helpers": "10.0.1",
    "@bifravst/eslint-config-typescript": "8.0.1",
    "@bifravst/prettier-config": "2.0.0",
    "@commitlint/config-conventional": "21.2.2",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "aws-cdk": "2.1138.0",
    "aws-cdk-lib": "2.265.0",
    "cdk": "2.1138.0",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "constructs": "10.8.1",
    "husky": "9.1.7",
    "p-retry": "8.0.0",
    "tsmatchers": "6.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ]
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "volta": {
    "node": "22.14.0"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "prettier": "@bifravst/prettier-config"
}
